# Normalize text files, but never touch bytes we do not own.
* text=auto

# The launchers are kept byte-exact on purpose:
#   VBridger-NoPreview.cmd     pure ASCII, so no code page can garble it
#   VBridger-NoPreview-zh.cmd  GBK (ANSI 936) + CRLF for zh-CN cmd.exe, which
#                              reads batch files with the OEM code page and has
#                              no BOM support
# Marking them "-text" keeps Git from rewriting line endings or re-encoding
# them, which would turn the menu into mojibake or break parsing. Do not "fix"
# these files to UTF-8.
*.cmd -text

# PowerShell handles both line endings; CRLF is friendlier for Windows users.
*.ps1 text eol=crlf
*.md  text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
